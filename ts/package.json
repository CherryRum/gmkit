{
  "name": "gmkitx",
  "version": "0.9.4",
  "description": "中国国密算法（SM2, SM3, SM4, ZUC）的纯 TypeScript 实现 / Pure TypeScript implementation of Chinese national cryptographic algorithms (SM2, SM3, SM4, ZUC)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "browser": {
    "./dist/index.cjs": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build:raw": "tsup",
    "build": "node scripts/build-with-warning-policy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "audit:pack": "node scripts/audit-pack-size.mjs",
    "audit:docs:assets": "node scripts/audit-doc-assets.mjs",
    "audit:slim": "npm run audit:docs:assets && npm run build && npm run audit:pack",
    "verify": "npm run type-check && npm run test && npm run build && npm run audit:pack",
    "demo:vue": "cd demo-vue && npm run dev",
    "prepublishOnly": "npm run verify",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "docs:clean": "cd docs && npm run clean",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "sm2",
    "sm3",
    "sm4",
    "zuc",
    "cryptography",
    "chinese-standard",
    "state-cipher",
    "gm",
    "guomi",
    "eea3",
    "eia3",
    "lte",
    "国密",
    "商密",
    "加密",
    "签名",
    "信创"
  ],
  "author": "yulin.1996@foxmail.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CherryRum/gmkit.git"
  },
  "bugs": {
    "url": "https://github.com/CherryRum/gmkit/issues"
  },
  "homepage": "https://github.com/CherryRum/gmkit#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.1",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vite": "7.1.11",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  }
}