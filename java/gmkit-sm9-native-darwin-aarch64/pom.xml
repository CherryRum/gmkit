<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.gmkit</groupId>
        <artifactId>gmkit-parent</artifactId>
        <version>0.10.0-SNAPSHOT</version>
    </parent>

    <artifactId>gmkit-sm9-native-darwin-aarch64</artifactId>
    <name>GMKit SM9 Native macOS aarch64</name>
    <description>GMKit SM9 native runtime for macOS aarch64</description>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-native-resources</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${project.basedir}/src/main/resources/native/darwin-aarch64/libgmkitsm9.dylib</file>
                                                <file>${project.basedir}/src/main/resources/native/darwin-aarch64/libgmssl.3.dylib</file>
                                            </files>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
