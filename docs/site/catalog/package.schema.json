{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmkit.cn/schemas/package-catalog.schema.json",
  "title": "GMKit documentation package catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/packageEntry"
      }
    }
  },
  "$defs": {
    "packageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "ecosystem",
        "coordinates",
        "version",
        "tagPrefix",
        "guide",
        "manual",
        "api",
        "apiGenerator",
        "testCommand",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "published",
            "deprecated"
          ]
        },
        "ecosystem": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "tagPrefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*-v$"
        },
        "guide": {
          "$ref": "#/$defs/siteRoute"
        },
        "manual": {
          "$ref": "#/$defs/siteRoute"
        },
        "api": {
          "$ref": "#/$defs/siteRoute"
        },
        "apiGenerator": {
          "type": "string",
          "minLength": 1
        },
        "testCommand": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "siteRoute": {
      "type": "string",
      "pattern": "^/[^?#]*$"
    }
  }
}
